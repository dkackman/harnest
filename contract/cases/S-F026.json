{
 "id": "S-F026",
 "level": "smoke",
 "title": "a task step that cannot run is refused by the free pre-flight",
 "note": "<any asset> is the common asset qa-cast/ep20-score.wav. run.py cannot compare two steps' answers, so the run_workflow refusal's 'identical message' is asserted by pinning the chained-omission message whole in both steps.",
 "steps": [
  {
   "label": "missing required argument: one error at its path, no plan",
   "call": "validate_workflow",
   "args": {
    "workflow": {
     "id": "contract-s-f026",
     "steps": [
      {
       "name": "a",
       "task": {
        "command": "resample_audio",
        "arguments": {
         "target_sample_rate": 16000
        }
       },
       "result": {
        "content_type": "audio/wav"
       }
      }
     ]
    }
   },
   "expect": [
    {
     "path": "valid",
     "eq": false
    },
    {
     "path": "errors",
     "len": 1
    },
    {
     "path": "errors[0].path",
     "eq": "steps[0].task.arguments.audio"
    },
    {
     "path": "errors[0].message",
     "contains": [
      "resample_audio",
      "'audio'"
     ]
    },
    {
     "path": "plan",
     "exists": false
    }
   ]
  },
  {
   "label": "unknown arguments are errors, not warnings: three errors, each at its own path",
   "call": "validate_workflow",
   "args": {
    "workflow": {
     "id": "contract-s-f026",
     "steps": [
      {
       "name": "a",
       "task": {
        "command": "crossfade_audio",
        "arguments": {
         "audio": "asset:qa-cast/ep20-score.wav",
         "other": "asset:qa-cast/ep20-score.wav",
         "crossfade_ms": 0
        }
       },
       "result": {
        "content_type": "audio/wav"
       }
      }
     ]
    }
   },
   "expect": [
    {
     "path": "valid",
     "eq": false
    },
    {
     "path": "errors",
     "len": 3
    },
    {
     "path": "errors",
     "any_contains": [
      "\"path\": \"steps[0].task.arguments.audios\"",
      "requires 'audios'"
     ]
    },
    {
     "path": "errors",
     "any_contains": [
      "\"path\": \"steps[0].task.arguments.audio\"",
      "does not accept argument 'audio'"
     ]
    },
    {
     "path": "errors",
     "any_contains": [
      "\"path\": \"steps[0].task.arguments.other\"",
      "does not accept argument 'other'"
     ]
    }
   ]
  },
  {
   "label": "positive control: a complete single step validates with a plan",
   "call": "validate_workflow",
   "args": {
    "workflow": {
     "id": "contract-s-f026",
     "steps": [
      {
       "name": "a",
       "task": {
        "command": "slice_audio",
        "arguments": {
         "audio": "asset:qa-cast/ep20-score.wav",
         "start_seconds": 0,
         "duration_seconds": 1
        }
       },
       "result": {
        "content_type": "audio/wav"
       }
      }
     ]
    }
   },
   "expect": [
    {
     "path": "valid",
     "eq": true
    },
    {
     "path": "plan.fingerprint",
     "exists": true
    },
    {
     "path": "errors",
     "none_contains": "signature"
    }
   ]
  },
  {
   "label": "positive control: a previous_result reference supplies the required argument",
   "call": "validate_workflow",
   "args": {
    "workflow": {
     "id": "contract-s-f026",
     "steps": [
      {
       "name": "a",
       "task": {
        "command": "slice_audio",
        "arguments": {
         "audio": "asset:qa-cast/ep20-score.wav",
         "start_seconds": 0,
         "duration_seconds": 1
        }
       },
       "result": {
        "content_type": "audio/wav"
       }
      },
      {
       "name": "b",
       "task": {
        "command": "resample_audio",
        "arguments": {
         "audio": "previous_result:a",
         "target_sample_rate": 16000
        }
       },
       "result": {
        "content_type": "audio/wav"
       }
      }
     ]
    }
   },
   "expect": [
    {
     "path": "valid",
     "eq": true
    },
    {
     "path": "plan.steps",
     "eq": 2
    }
   ]
  },
  {
   "label": "chained omission is refused at step index 1",
   "call": "validate_workflow",
   "args": {
    "workflow": {
     "id": "contract-s-f026",
     "steps": [
      {
       "name": "a",
       "task": {
        "command": "slice_audio",
        "arguments": {
         "audio": "asset:qa-cast/ep20-score.wav",
         "start_seconds": 0,
         "duration_seconds": 1
        }
       },
       "result": {
        "content_type": "audio/wav"
       }
      },
      {
       "name": "b",
       "task": {
        "command": "resample_audio",
        "arguments": {
         "target_sample_rate": 16000
        }
       },
       "result": {
        "content_type": "audio/wav"
       }
      }
     ]
    }
   },
   "expect": [
    {
     "path": "valid",
     "eq": false
    },
    {
     "path": "errors[0].path",
     "eq": "steps[1].task.arguments.audio"
    },
    {
     "path": "errors[0].message",
     "eq": "task 'resample_audio' requires 'audio', which the step does not supply. A task's 'arguments' are the whole of what reaches the command, so a required argument left out is a run that cannot start."
    }
   ]
  },
  {
   "label": "run_workflow refuses that body at the gate with the identical message",
   "call": "run_workflow",
   "args": {
    "inline_workflow": {
     "id": "contract-s-f026",
     "steps": [
      {
       "name": "a",
       "task": {
        "command": "slice_audio",
        "arguments": {
         "audio": "asset:qa-cast/ep20-score.wav",
         "start_seconds": 0,
         "duration_seconds": 1
        }
       },
       "result": {
        "content_type": "audio/wav"
       }
      },
      {
       "name": "b",
       "task": {
        "command": "resample_audio",
        "arguments": {
         "target_sample_rate": 16000
        }
       },
       "result": {
        "content_type": "audio/wav"
       }
      }
     ]
    },
    "acknowledged_cost": true
   },
   "is_error": true,
   "expect": [
    {
     "path": "",
     "contains": [
      "Error executing tool run_workflow",
      "steps[1].task.arguments.audio: task 'resample_audio' requires 'audio', which the step does not supply. A task's 'arguments' are the whole of what reaches the command, so a required argument left out is a run that cannot start."
     ]
    },
    {
     "path": "",
     "not_contains": "job_id"
    }
   ]
  }
 ]
}
