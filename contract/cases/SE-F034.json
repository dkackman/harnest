     "contains_any": [
      "backslash",
      "nvalid URL"
     ]
    }
   ]
  },
  {
   "label": "(e) the same probe as a pipeline argument on an image-conditioned template",
   "call": "validate_workflow",
   "args": {
    "name": "templates/image-to-image",
    "arguments": {
     "image": "http://169.254.169.254\\@example.com/a.png"
    }
   },
   "expect": [
    {
     "path": "valid",
     "eq": false
    },
    {
     "path": "errors",
     "any_contains": [
      "\"path\": \"steps[0].pipeline.arguments.image\""
     ]
    },
    {
     "path": "errors[*].message",
     "contains_any": [
      "backslash",
      "nvalid URL"
     ]
    }
   ]
  },
  {
   "label": "(f) remote_text_encoder.url, evil host before the backslash",
   "call": "validate_workflow",
   "args": {
    "workflow": {
     "id": "contract-se-f034",
     "steps": [
      {
       "name": "g",
       "pipeline": {
        "configuration": {
         "component_type": "StableDiffusionPipeline"
        },
        "from_pretrained_arguments": {
         "model_name": "stable-diffusion-v1-5/stable-diffusion-v1-5"
        },
