# The harness's secrets: copy to .env (gitignored) and fill in.
#   cp .env.example .env
#
# Read by providers.sh and harness/profile.py (load_env_file), never
# sourced: KEY=value lines, `#` comments, no inline comments. Only DW_TOKEN
# and DW_TOKEN_* are read from it; knobs belong on the command line or in
# your shell. A variable already set in the environment wins over this file.
# HARNEST_ENV_FILE points the drivers at another file.

# The dw MCP server's Bearer token, one per server (DW_TOKEN_<TARGET>: the
# target name upper-cased, "-" as "_").
DW_TOKEN_LEM=
DW_TOKEN_MINI_AI=
DW_TOKEN_MINID=

# Fallback for a server whose own variable is unset.
# DW_TOKEN=
